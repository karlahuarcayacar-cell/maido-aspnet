@{
    ViewData["Title"] = "Iniciar Sesión - Maido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <!-- Logo + Título -->
        <div class="auth-logo">鮨</div>
        <h1 class="auth-title">Bienvenido</h1>
        <p class="text-center text-muted mb-4 small">Inicia sesión para continuar con tu pedido</p>

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success py-2 mb-3">
                <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="form-label"><i class="bi bi-envelope me-1"></i>Correo electrónico</label>
                <input type="email" name="Email" class="form-control" id="loginEmail"
                       placeholder="tu@email.com" autocomplete="email" required />
            </div>

            <div class="mb-4">
                <label class="form-label"><i class="bi bi-lock me-1"></i>Contraseña</label>
                <div class="input-group">
                    <input type="password" name="Password" class="form-control" id="loginPassword"
                           placeholder="••••••••" autocomplete="current-password" required />
                    <button class="btn" type="button" style="background:var(--bg-elevated);border:1.5px solid var(--border-subtle);color:var(--text-muted);"
                            onclick="togglePassword('loginPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-accent w-100 py-2" id="btnLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
            </button>
        </form>

        <hr class="my-4" style="border-color:var(--border-subtle);">

        <p class="text-center text-muted small">
            ¿No tienes cuenta?
            <a asp-controller="Account" asp-action="Register" class="text-gold fw-semibold">Regístrate aquí</a>
        </p>

        <p class="text-center mt-2">
            <a asp-controller="Home" asp-action="Index" class="text-muted small">
                <i class="bi bi-arrow-left me-1"></i>Volver al menú
            </a>
        </p>

    </div>
</div>

@section Scripts {
<script>
function togglePassword(id, btn) {
    const input = document.getElementById(id);
    const isText = input.type === 'text';
    input.type = isText ? 'password' : 'text';
    btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
}
</script>
}
