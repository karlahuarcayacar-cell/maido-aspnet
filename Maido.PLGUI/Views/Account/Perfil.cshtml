@using Maido.Application.BL.BC.DTOs
@using Maido.PLGUI.Helpers
@model PerfilDto

@{
    ViewData["Title"] = "Mi Perfil";
    var initials = (!string.IsNullOrEmpty(Model?.Nombre) ? Model.Nombre.Substring(0, 1) : "") +
                   (!string.IsNullOrEmpty(Model?.Apellido) ? Model.Apellido.Substring(0, 1) : "");
    var rolNombre = SesionHelper.EsAdministrador(Context.Session) ? "Admin" : "Cliente";
}

<div class="perfil-page">
  <div class="container">
    <div class="perfil-layout">
      <div class="perfil-sidebar">
        <div class="user-card card">
          <div class="user-avatar-lg">@initials</div>
          <h2 class="user-name">@Model?.Nombre @Model?.Apellido</h2>
          <p class="user-email text-muted">@Model?.Email</p>
          <div class="user-stats">
            <div class="stat">
              <span class="stat-value text-gold">@rolNombre</span>
              <span class="stat-label">Rol</span>
            </div>
          </div>
        </div>
      </div>

      <div class="perfil-content">
        <div class="card glass-card">
          <div class="card-header">
            <h2>Mis Datos Personales</h2>
            <p class="text-muted">Actualiza tu información para agilizar tus futuros pedidos.</p>
          </div>

          @if (TempData["Exito"] != null)
          {
              <div class="alert alert-success" style="margin-bottom: 1.5rem;">
                  @TempData["Exito"]
              </div>
          }

          <form asp-action="Perfil" method="post" class="perfil-form">
            <input type="hidden" asp-for="IdUsuario" />
            <input type="hidden" asp-for="Email" />
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Nombre *</label>
                <input asp-for="Nombre" type="text" class="form-input" />
                <span asp-validation-for="Nombre" class="form-error"></span>
              </div>
              <div class="form-group">
                <label class="form-label">Apellido *</label>
                <input asp-for="Apellido" type="text" class="form-input" />
                <span asp-validation-for="Apellido" class="form-error"></span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Correo Electrónico</label>
              <input type="email" class="form-input" value="@Model?.Email" readonly style="opacity:0.6;cursor:not-allowed">
              <small class="text-muted" style="display:block;margin-top:0.25rem">El correo no se puede cambiar.</small>
            </div>

            <h3 style="margin:2rem 0 1rem; border-bottom:1px solid var(--border); padding-bottom:0.5rem">Datos de Entrega por Defecto</h3>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Teléfono</label>
                <input asp-for="Telefono" type="tel" class="form-input" placeholder="Ej. 987654321">
                <span asp-validation-for="Telefono" class="form-error"></span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Dirección Principal</label>
              <input asp-for="Direccion" type="text" class="form-input" placeholder="Ej. Av. La Paz 123, Miraflores">
              <small class="text-muted" style="display:block;margin-top:0.25rem">Esta dirección se autocompletará al hacer Checkout.</small>
              <span asp-validation-for="Direccion" class="form-error"></span>
            </div>

            <div class="form-actions">
              <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">Deshacer cambios</a>
              <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
