@model Maido.Application.BL.BC.DTOs.RegistrarUsuarioDto
@{
    ViewData["Title"] = "Crear Cuenta - Maido";
}

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <span class="logo-jp display-font">間道</span>
      <span class="logo-text">MAIDO</span>
    </div>
    <h2 class="auth-title">Crear Cuenta</h2>
    <p class="text-muted" style="text-align:center;margin-bottom:2rem">Únete a la experiencia Nikkei</p>

    <form asp-controller="Account" asp-action="Register" method="post">
      @Html.AntiForgeryToken()

      <div asp-validation-summary="All" class="error-msg"></div>
      @if (ViewBag.Error != null)
      {
        <div class="error-msg">@ViewBag.Error</div>
      }

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" asp-for="Nombre">Nombre</label>
          <input type="text" class="form-input" asp-for="Nombre" placeholder="Kenji" required />
          <span class="form-error" asp-validation-for="Nombre"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="Apellido">Apellido</label>
          <input type="text" class="form-input" asp-for="Apellido" placeholder="Fujimoto" required />
          <span class="form-error" asp-validation-for="Apellido"></span>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:1rem">
        <label class="form-label" asp-for="Email">Correo Electrónico</label>
        <input type="email" class="form-input" asp-for="Email" placeholder="tu@correo.com" required />
        <span class="form-error" asp-validation-for="Email"></span>
      </div>
      <div class="form-group" style="margin-bottom:1rem">
        <label class="form-label" asp-for="Password">Contraseña</label>
        <input type="password" class="form-input" asp-for="Password" placeholder="Mínimo 6 caracteres" required />
        <span class="form-error" asp-validation-for="Password"></span>
      </div>
      <div class="form-group" style="margin-bottom:1rem">
        <label class="form-label" asp-for="ConfirmarPassword">Confirmar Contraseña</label>
        <input type="password" class="form-input" asp-for="ConfirmarPassword" placeholder="Repite tu contraseña" />
        <span class="form-error" asp-validation-for="ConfirmarPassword"></span>
      </div>
      <div class="form-group" style="margin-bottom:1.5rem">
        <label class="form-label" asp-for="Telefono">Teléfono (opcional)</label>
        <input type="tel" class="form-input" asp-for="Telefono" placeholder="999 000 000" />
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">
        Crear Cuenta
      </button>
    </form>

    <div class="auth-footer">
      <p class="text-muted">¿Ya tienes cuenta? <a asp-controller="Account" asp-action="Login" class="text-accent">Inicia sesión</a></p>
    </div>
  </div>
</div>
