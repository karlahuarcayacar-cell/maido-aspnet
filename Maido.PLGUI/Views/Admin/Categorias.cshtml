@using Maido.Application.BL.BC.DTOs
@model IEnumerable<CategoriaDto>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Gestión de Categorías</h2>
            <p class="text-muted">Administra las categorías de la carta Nikkei</p>
        </div>
        <a asp-action="CrearCategoria" class="btn btn-accent">
            <i class="bi bi-plus-circle me-1"></i> Nueva Categoría
        </a>
    </div>

    <div class="maido-table">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Icono</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var icono = string.IsNullOrWhiteSpace(c.Icono) ? "bi-tag" : c.Icono;
                    <tr>
                        <td class="text-muted fw-bold">@c.Orden</td>
                        <td>
                            <i class="bi @icono fs-5 text-gold"></i>
                        </td>
                        <td class="fw-bold">@c.Nombre</td>
                        <td class="text-muted">@(c.Descripcion?.Length > 50 ? c.Descripcion.Substring(0, 50) + "..." : c.Descripcion)</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge-estado badge-activo">Activo</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-inactivo">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="EditarCategoria" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="EliminarCategoria" asp-route-id="@c.IdCategoria" method="post"
                                      class="d-inline ms-1" id="formEliminar-@c.IdCategoria">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            onclick="confirmarEliminarCategoria('formEliminar-@c.IdCategoria', '@c.Nombre')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No hay categorías registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .swal2-popup.maido-swal-popup {
            background: var(--bg-card);
            color: var(--text-primary);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg, 12px);
        }
        .swal2-popup.maido-swal-popup .swal2-title,
        .swal2-popup.maido-swal-popup .swal2-html-container {
            color: var(--text-primary);
        }
    </style>
    <script>
        function confirmarEliminarCategoria(formId, nombreCategoria) {
            Swal.fire({
                title: '¿Eliminar categoría?',
                html: `Se eliminará <strong>${nombreCategoria}</strong>. Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                customClass: { popup: 'maido-swal-popup' }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
    </script>
}