@using Maido.Application.BL.BC.DTOs
@model IEnumerable<CategoriaDto>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem">
            <div>
                <h1 style="margin-bottom:0.25rem">Gestión de <span class="text-accent">Categorías</span></h1>
                <p class="text-muted">Administra las categorías de la carta Nikkei</p>
            </div>
            <a asp-action="CrearCategoria" class="btn btn-primary">
                + Nueva Categoría
            </a>
        </div>

        <div class="table-wrapper card">
            <table>
                <thead>
                    <tr>
                        <th>Orden</th>
                        <th>Icono</th>
                        <th>Categoría</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var icono = string.IsNullOrWhiteSpace(c.Icono) ? "bi-tag" : c.Icono;
                        <tr>
                            <td class="text-muted fw-bold">@c.Orden</td>
                            <td>
                                <i class="bi @icono text-gold" style="font-size: 1.2rem;"></i>
                            </td>
                            <td><b>@c.Nombre</b></td>
                            <td class="text-muted">@(c.Descripcion?.Length > 50 ? c.Descripcion.Substring(0, 50) + "..." : c.Descripcion)</td>
                            <td>
                                @if (c.Activo)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactivo</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="flex justify-between gap-1" style="justify-content: flex-end;">
                                    <a asp-action="EditarCategoria" asp-route-id="@c.IdCategoria" class="btn btn-ghost btn-sm" title="Editar">
                                        ✏️
                                    </a>
                                    <form asp-action="EliminarCategoria" asp-route-id="@c.IdCategoria" method="post"
                                          style="margin: 0;" id="formEliminar-@c.IdCategoria">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-ghost btn-sm" style="color: var(--danger);" title="Eliminar"
                                                onclick="confirmarEliminarCategoria('formEliminar-@c.IdCategoria', '@c.Nombre')">
                                            🗑
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted)">No hay categorías registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminarCategoria(formId, nombreCategoria) {
            Swal.fire({
                title: 'Eliminar categoría',
                html: `<p class="text-muted" style="margin-bottom:0.25rem">¿Estás seguro de que deseas eliminar la categoría</p>
                       <p style="font-weight:700;color:var(--accent-gold);margin-bottom:0.75rem;font-size:1.1rem">"${nombreCategoria}"?</p>
                       <p class="text-muted" style="font-size:0.82rem;margin-bottom:0">Esta acción no se puede deshacer.</p>`,
                iconHtml: '<span style="font-size:2.5rem;display:block;">🗑</span>',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#D9381E',
                cancelButtonColor: 'rgba(255,255,255,0.05)',
                background: '#1E1E24',
                color: '#F4F4F6',
                customClass: {
                    popup: 'maido-swal-popup',
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-ghost'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
    </script>
}
