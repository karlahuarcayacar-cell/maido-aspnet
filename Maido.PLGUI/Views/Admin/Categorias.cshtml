@using Maido.Application.BL.BC.DTOs
@model IEnumerable<CategoriaDto>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Gestión de Categorías</h2>
            <p class="text-muted">Administra las categorías de la carta Nikkei</p>
        </div>
        <a asp-action="CrearCategoria" class="btn btn-accent">
            <i class="bi bi-plus-circle me-1"></i> Nueva Categoría
        </a>
    </div>

    <div class="maido-table">
        <table class="table table-dark table-hover mb-0" style="background-color: transparent;">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Icono</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">@c.Orden</td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.Icono))
                            {
                                <i class="bi @c.Icono fs-5 text-gold"></i>
                            }
                        </td>
                        <td class="fw-bold">@c.Nombre</td>
                        <td class="text-muted">@(c.Descripcion?.Length > 50 ? c.Descripcion.Substring(0, 50) + "..." : c.Descripcion)</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="EditarCategoria" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-outline-gold">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="EliminarCategoria" asp-route-id="@c.IdCategoria" method="post" class="d-inline ms-1" onsubmit="return confirm('¿Estás seguro de eliminar o desactivar esta categoría?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No hay categorías registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    </div>
</div>
