@using Maido.Application.BL.BC.DTOs
@model CrearCategoriaDto

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <div class="flex items-center gap-2" style="margin-bottom: 1.5rem;">
            <a asp-action="Categorias" class="btn btn-ghost btn-icon">
                ←
            </a>
            <h1 style="margin: 0;">Nueva <span class="text-accent">Categoría</span></h1>
        </div>

        <div class="card" style="max-width: 600px;">
            <div class="card-body">
                <form asp-action="CrearCategoria" method="post" class="flex flex-col gap-2">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label asp-for="Nombre" class="form-label">Nombre *</label>
                        <input asp-for="Nombre" class="form-input" placeholder="Ej. Entradas Calientes" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-input" rows="3" placeholder="Breve descripción..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Icono" class="form-label">Icono (Clase Bootstrap)</label>
                            <input asp-for="Icono" class="form-input" placeholder="Ej. bi-cup-hot" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Orden" class="form-label">Orden</label>
                            <input asp-for="Orden" type="number" class="form-input" value="0" />
                            <span asp-validation-for="Orden" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="flex gap-2 justify-between items-center">
                        <a asp-action="Categorias" class="btn btn-ghost">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            Guardar Categoría
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
