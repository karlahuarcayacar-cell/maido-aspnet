@using Maido.Application.BL.BC.DTOs
@model CrearCategoriaDto

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Categorias" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="mb-0">Nueva Categoría</h2>
            </div>

            <div class="card maido-card">
                <div class="card-body p-4">
                    <form asp-action="CrearCategoria" method="post">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label text-muted small text-uppercase fw-bold">Nombre</label>
                            <input asp-for="Nombre" class="form-control form-control-lg maido-input" placeholder="Ej. Entradas Calientes" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label text-muted small text-uppercase fw-bold">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control maido-input" rows="3" placeholder="Breve descripción..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Icono" class="form-label text-muted small text-uppercase fw-bold">Icono (Clase Bootstrap)</label>
                                <input asp-for="Icono" class="form-control maido-input" placeholder="Ej. bi-cup-hot" />
                                <div class="form-text text-secondary mt-1">Busca iconos en <a href="https://icons.getbootstrap.com/" target="_blank" class="text-gold">Bootstrap Icons</a></div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Orden" class="form-label text-muted small text-uppercase fw-bold">Orden (Visualización)</label>
                                <input asp-for="Orden" type="number" class="form-control maido-input" value="0" />
                                <span asp-validation-for="Orden" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100">
                            <i class="bi bi-save me-2"></i>Guardar Categoría
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
