@using Maido.Application.BL.BC.DTOs
@model CrearPlatilloDto

@{
    ViewData["Title"] = "Nuevo Platillo - Admin";
    var categorias = ViewBag.Categorias as IEnumerable<CategoriaDto> ?? [];
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">
        <div class="flex items-center gap-2" style="margin-bottom: 1.5rem;">
            <a asp-action="Platillos" class="btn btn-ghost btn-icon">
                ←
            </a>
            <h1 style="margin: 0;">Nuevo <span class="text-accent">Platillo</span></h1>
        </div>

        <div class="card" style="max-width: 650px;">
            <div class="card-body">
                <form asp-action="CrearPlatillo" method="post" enctype="multipart/form-data" class="flex flex-col gap-2">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small margin-bottom-3"></div>

                    <div class="form-group">
                        <label class="form-label">Nombre del Platillo *</label>
                        <input type="text" name="Nombre" class="form-input" placeholder="Ej: Dragon Roll" value="@Model.Nombre" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Descripción *</label>
                        <textarea name="Descripcion" class="form-input" rows="3" placeholder="Describe los ingredientes y sabores del platillo...">@Model.Descripcion</textarea>
                        @Html.ValidationMessage("Descripcion", new { @class = "text-danger small" })
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label class="form-label">Precio (S/) *</label>
                            <input type="number" name="Precio" class="form-input" step="0.01" min="0.01" placeholder="0.00" value="@(Model.Precio > 0 ? Model.Precio.ToString() : "")" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Categoría *</label>
                            <select name="IdCategoria" class="form-input" required>
                                <option value="">Seleccionar categoría</option>
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat.IdCategoria" selected="@(Model.IdCategoria == cat.IdCategoria)">@cat.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Imagen -->
                    <div class="form-group">
                        <label class="form-label">Imagen del Platillo</label>
                        <input type="file" name="imagenFile" class="form-input" id="imagenInput" accept=".jpg,.jpeg,.png,.webp" onchange="previewImagen(this)" />
                        <img id="imgPreview" style="display:none; width:120px; height:90px; object-fit:cover; border-radius:var(--radius-sm); border:1px solid var(--border); margin-top: 0.75rem;" src="#" alt="Preview" />
                    </div>

                    <div class="flex gap-4" style="margin-top: 0.5rem;">
                        <label class="flex items-center gap-1" style="cursor: pointer;">
                            <input type="checkbox" name="Disponible" value="true" @(Model.Disponible ? "checked" : "") />
                            <span class="form-label" style="margin: 0;">Disponible (en stock)</span>
                        </label>

                        <label class="flex items-center gap-1" style="cursor: pointer;">
                            <input type="checkbox" name="Destacado" value="true" @(Model.Destacado ? "checked" : "") />
                            <span class="form-label" style="margin: 0;">⭐ Destacado</span>
                        </label>
                    </div>

                    <div class="divider"></div>

                    <div class="flex gap-2 justify-between items-center">
                        <a asp-action="Platillos" class="btn btn-ghost">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            Guardar Platillo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewImagen(input) {
    const preview = document.getElementById('imgPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
            preview.src = e.target.result;
            preview.classList.remove('d-none');
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}

