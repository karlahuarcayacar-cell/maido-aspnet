@using Maido.Application.BL.BC.DTOs

@{
    ViewData["Title"] = "Dashboard - Admin Maido";
    var nombreAdmin = ViewBag.NombreAdmin as string ?? "Admin";
    var ultimosPedidos = ViewBag.UltimosPedidos as IEnumerable<PedidoResumenDto> ?? Enumerable.Empty<PedidoResumenDto>();
    dynamic? stats = ViewBag.Stats;
}

@functions {
    string BadgeClass(string? estado)
    {
        var e = estado?.ToUpper()?.Replace(" ", "_") ?? "";
        return e switch
        {
            "PENDIENTE" or "EN_PREPARACION" => "badge-warning",
            "EN_CAMINO" => "badge-gold",
            "ENTREGADO" => "badge-success",
            "CANCELADO" => "badge-danger",
            _ => "badge-gold"
        };
    }
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">
        <div>
            <h1 style="margin-bottom:0.5rem">Dashboard <span class="text-accent">Admin</span></h1>
            <p class="text-muted" style="margin-bottom:2.5rem">Métricas operativas del día en tiempo real</p>

            @if (stats != null)
            {
                <div class="stats-grid">
                    <div class="stat-card card card-body">
                        <div class="stat-icon" style="color:var(--accent-gold)">💰</div>
                        <div>
                            <p class="stat-label text-muted">Ingresos de Hoy</p>
                            <p class="stat-value text-gold">S/ @string.Format("{0:N2}", stats.ingresosHoy)</p>
                            <p style="font-size:0.75rem;margin-top:0.25rem;opacity:0.6">Total histórico: S/ @string.Format("{0:N2}", stats.ingresosTotales)</p>
                        </div>
                    </div>

                    <div class="stat-card card card-body">
                        <div class="stat-icon" style="color:#60a5fa">📦</div>
                        <div>
                            <p class="stat-label text-muted">Nuevos Pedidos (Hoy)</p>
                            <p class="stat-value">@stats.pedidosHoy</p>
                        </div>
                    </div>

                    <div class="stat-card card card-body">
                        <div class="stat-icon" style="color:#f59e0b">⏳</div>
                        <div>
                            <p class="stat-label text-muted">Pedidos Activos</p>
                            <p class="stat-value" style="color:#f59e0b">@stats.pedidosActivos</p>
                            <p style="font-size:0.75rem;margin-top:0.25rem;opacity:0.6">En cocina o en camino</p>
                        </div>
                    </div>

                    <div class="stat-card card card-body @(stats.platillosAgotados > 0 ? "alert-border" : "")">
                        <div class="stat-icon" style="color:#f44336">⚠️</div>
                        <div>
                            <p class="stat-label text-muted">Platillos Agotados</p>
                            <p class="stat-value" style="color:@(stats.platillosAgotados > 0 ? "#f44336" : "#fff")">@stats.platillosAgotados</p>
                            @if (stats.platillosAgotados > 0)
                            {
                                <a asp-action="Platillos" style="font-size:0.75rem;margin-top:0.25rem;color:#f44336;display:block">Ir a reponer stock →</a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Accesos rápidos -->
            <div class="quick-links">
                <a asp-action="Platillos" class="quick-card card card-body">
                    <span class="quick-icon">🍣</span>
                    <h3>Gestionar Menú</h3>
                    <p class="text-muted">CRUD de platillos y control de stock</p>
                </a>
                <a asp-action="Pedidos" class="quick-card card card-body">
                    <span class="quick-icon">📋</span>
                    <h3>Gestión de Pedidos</h3>
                    <p class="text-muted">Flujo de estados y despachos</p>
                </a>
                <a asp-action="Reportes" class="quick-card card card-body">
                    <span class="quick-icon">📊</span>
                    <h3>Reportes PDF</h3>
                    <p class="text-muted">Exportar ventas por rango de fechas</p>
                </a>
            </div>

            <!-- Últimos pedidos -->
            <div class="recent-section">
                <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:1.25rem">
                    <h2 style="margin:0">Últimos Pedidos</h2>
                    <a asp-action="Pedidos" class="text-accent" style="font-size:0.9rem">Ver todos →</a>
                </div>

                <div class="table-wrapper card">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in ultimosPedidos)
                            {
                                var isPendiente = p.Estado?.ToUpper() == "PENDIENTE";
                                <tr class="@(isPendiente ? "urgent-row" : "")">
                                    <td><b>#@p.IdPedido</b></td>
                                    <td>@p.NombreCliente</td>
                                    <td class="text-muted" style="font-size:0.85rem">@p.FechaPedido.ToString("dd/MM/yy HH:mm")</td>
                                    <td class="price">S/ @p.Total.ToString("F2")</td>
                                    <td>
                                        <span class="badge @BadgeClass(p.Estado)">@p.Estado</span>
                                        @if (isPendiente)
                                        {
                                            <span class="ping"></span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!ultimosPedidos.Any())
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted)">No hay pedidos recientes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
