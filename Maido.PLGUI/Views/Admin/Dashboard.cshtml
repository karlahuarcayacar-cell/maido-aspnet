@using Maido.Application.BL.BC.DTOs

@{
    ViewData["Title"] = "Dashboard - Admin Maido";
    var nombreAdmin = ViewBag.NombreAdmin as string ?? "Admin";
    var ultimosPedidos = ViewBag.UltimosPedidos as IEnumerable<PedidoResumenDto> ?? [];
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">

        <!-- Bienvenida -->
        <div class="mb-5">
            <h2 class="mb-0">Bienvenido, <span class="text-accent">@nombreAdmin.Split(' ')[0]</span></h2>
            <p class="text-muted">Panel de administración del Restaurante Maido</p>
        </div>

        <!-- Stats cards -->
        <div class="row g-4 mb-5">
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-label mb-1">Gestión de Platillos</div>
                    <div class="stat-value text-accent">🍽️</div>
                    <div class="mt-2">
                        <a asp-action="Platillos" class="btn btn-sm btn-outline-accent">Administrar</a>
                    </div>
                    <i class="bi bi-egg-fried stat-icon"></i>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card gold">
                    <div class="stat-label mb-1">Categorías</div>
                    <div class="stat-value">📂</div>
                    <div class="mt-2">
                        <a asp-action="Categorias" class="btn btn-sm btn-gold">Administrar</a>
                    </div>
                    <i class="bi bi-tags stat-icon"></i>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card success">
                    <div class="stat-label mb-1">Monitor de Pedidos</div>
                    <div class="stat-value">📋</div>
                    <div class="mt-2">
                        <a asp-action="Pedidos" class="btn btn-sm" style="background:var(--success);color:#fff;">Ver Pedidos</a>
                    </div>
                    <i class="bi bi-receipt stat-icon"></i>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-label mb-1">Reportes</div>
                    <div class="stat-value">📊</div>
                    <div class="mt-2">
                        <a asp-action="Reportes" class="btn btn-sm btn-outline-accent">Ver Reportes</a>
                    </div>
                    <i class="bi bi-bar-chart stat-icon"></i>
                </div>
            </div>
        </div>

        <!-- Últimos pedidos -->
        <div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 fw-bold">Últimos Pedidos</h5>
                <a asp-action="Pedidos" class="btn btn-sm btn-outline-accent">Ver todos</a>
            </div>

            <div class="maido-table">
                <table class="table table-hover mb-0" style="color:var(--text-primary);">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Tipo</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ultimosPedidos)
                        {
                            <tr>
                                <td class="text-gold fw-bold">#@p.IdPedido</td>
                                <td>—</td>
                                <td>@p.TipoPedido</td>
                                <td class="fw-bold">S/ @p.Total.ToString("F2")</td>
                                <td><span class="badge-estado badge-@p.Estado.Replace(" ",".")">@p.Estado</span></td>
                                <td class="text-muted small">@p.FechaPedido.ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                        @if (!ultimosPedidos.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Sin pedidos registrados aún.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
