@using Maido.Application.BL.BC.DTOs
@model ActualizarPlatilloDto

@{
    ViewData["Title"] = "Editar Platillo - Admin";
    var categorias = ViewBag.Categorias as IEnumerable<CategoriaDto> ?? [];
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Platillos" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="mb-0">Editar Platillo</h2>
        </div>

        <div class="checkout-card" style="max-width:680px;">
            <form asp-action="EditarPlatillo" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdPlatillo" value="@Model.IdPlatillo" />
                <input type="hidden" name="ImagenUrl" value="@Model.ImagenUrl" />

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nombre del Platillo *</label>
                        <input type="text" name="Nombre" class="form-control" value="@Model.Nombre" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descripción *</label>
                        <textarea name="Descripcion" class="form-control" rows="3">@Model.Descripcion</textarea>
                        @Html.ValidationMessage("Descripcion", new { @class = "text-danger small" })
                    </div>

                    <div class="col-sm-5">
                        <label class="form-label">Precio (S/) *</label>
                        <input type="number" name="Precio" class="form-control" step="0.01"
                               value="@Model.Precio" required />
                    </div>

                    <div class="col-sm-7">
                        <label class="form-label">Categoría *</label>
                        <select name="IdCategoria" class="form-select" required>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.IdCategoria" selected="@(Model.IdCategoria == cat.IdCategoria)">
                                    @cat.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Imagen actual + nueva -->
                    <div class="col-12">
                        <label class="form-label"><i class="bi bi-image me-1"></i>Imagen</label>
                        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="img-upload-preview" id="imgPreview" />
                                <p class="form-text mt-1">Imagen actual. Sube una nueva para reemplazarla.</p>
                            </div>
                        }
                        else
                        {
                            <img id="imgPreview" class="img-upload-preview d-none" src="#" alt="Preview" />
                            <p class="form-text">Sin imagen. Sube una para este platillo.</p>
                        }
                        <input type="file" name="imagenFile" class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" onchange="previewImagen(this)" />
                    </div>

                    <div class="col-sm-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="Disponible" id="chkDisponible"
                                   value="true" @(Model.Disponible ? "checked" : "") />
                            <label class="form-check-label" for="chkDisponible">Disponible en menú</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="Destacado" id="chkDestacado"
                                   value="true" @(Model.Destacado ? "checked" : "") />
                            <label class="form-check-label" for="chkDestacado">⭐ Platillo Destacado</label>
                        </div>
                    </div>

                    <div class="col-12 d-flex gap-3 mt-2">
                        <button type="submit" class="btn btn-accent px-4">
                            <i class="bi bi-floppy me-2"></i>Actualizar Platillo
                        </button>
                        <a asp-action="Platillos" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewImagen(input) {
    const preview = document.getElementById('imgPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
            preview.src = e.target.result;
            preview.classList.remove('d-none');
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
