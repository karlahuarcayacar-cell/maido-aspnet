@using Maido.Application.BL.BC.DTOs
@model PlatillosPaginadoDto

@{
    ViewData["Title"] = "Gestión de Platillos - Admin";
    var categorias = ViewBag.Categorias as IEnumerable<CategoriaDto> ?? [];
    var idCat = ViewBag.IdCategoriaActual as int?;
    var busqueda = ViewBag.Busqueda as string;
}

<style>
    /* --- Filter bar --- */
    .filter-bar {
      display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;
    }
    .filter-chip {
      display: flex; align-items: center; gap: 0.4rem;
      padding: 0.45rem 1rem; border-radius: 999px;
      border: 1px solid var(--border, #333); background: transparent;
      color: var(--text-muted, #aaa); cursor: pointer; font-family: inherit;
      font-size: 0.85rem; transition: all 0.2s; text-decoration: none;
    }
    .filter-chip:hover { border-color: var(--accent-gold, #e0a96d); color: var(--text-primary, #fff); }
    .filter-chip.active {
      background: rgba(224,169,109,0.12); border-color: var(--accent-gold, #e0a96d);
      color: var(--accent-gold, #e0a96d); font-weight: 600;
    }
    .chip-count {
      background: rgba(255,255,255,0.08); padding: 1px 7px;
      border-radius: 999px; font-size: 0.75rem; font-weight: 600;
    }
    .filter-chip.active .chip-count {
      background: rgba(224,169,109,0.2);
    }

    /* --- Toggle switch --- */
    .toggle-switch {
      position: relative; display: inline-block; width: 40px; height: 22px; cursor: pointer;
    }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: #444; border-radius: 22px; transition: 0.25s;
    }
    .toggle-slider::before {
      content: ''; position: absolute; height: 16px; width: 16px;
      left: 3px; bottom: 3px; background: #fff; border-radius: 50%;
      transition: 0.25s;
    }
    .toggle-switch input:checked + .toggle-slider { background: #4caf50; }
    .toggle-switch input:checked + .toggle-slider::before { transform: translateX(18px); }

    /* --- Row states --- */
    .row-inactive td:not(:last-child) { opacity: 0.4; }
    .row-agotado td:not(:last-child):not(:nth-child(5)) { opacity: 0.55; }

    /* --- Status badges --- */
    .status-badge {
      display: inline-block; margin-left: 0.5rem; font-size: 0.7rem;
      padding: 2px 8px; border-radius: 4px; font-weight: 600;
    }
    .badge-deleted { background: rgba(244,67,54,0.15); color: #f44336; }
    .badge-agotado { background: rgba(255,152,0,0.15); color: #ff9800; }

    /* --- Buttons --- */
    .btn-restore { color: #4caf50 !important; border-color: #4caf50 !important; }
    .btn-restore:hover { background: rgba(76,175,80,0.1); }
    .btn-danger {
      background: #D9381E; color: #fff; border: none; padding: 0.6rem 1.5rem;
      border-radius: var(--radius-sm, 4px); cursor: pointer; font-weight: 600;
      font-family: inherit; font-size: 0.9rem; transition: background 0.2s;
    }
    .btn-danger:hover { background: #b52d17; }

    /* --- Confirm modal --- */
    .confirm-box {
      background: var(--bg-card, #1e1e24); border: 1px solid var(--border, #333); border-radius: var(--radius-lg, 8px);
      padding: 2.5rem; width: 100%; max-width: 400px; box-shadow: var(--shadow-card);
      text-align: center; animation: confirmIn 0.2s ease-out;
    }
    .confirm-icon {
      font-size: 2.5rem; margin-bottom: 1rem;
      animation: confirmShake 0.4s ease-in-out;
    }
    @@keyframes confirmIn {
      from { opacity: 0; transform: scale(0.9); }
      to   { opacity: 1; transform: scale(1); }
    }
    @@keyframes confirmShake {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-8deg); }
      75% { transform: rotate(8deg); }
    }
</style>

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-content">
        <div>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem">
                <div>
                    <h1 style="margin-bottom:0.25rem">Gestión de <span class="text-accent">Platillos</span></h1>
                    <p class="text-muted">@Model.TotalRegistros platillos en total</p>
                </div>
                <a asp-action="CrearPlatillo" class="btn btn-primary">+ Nuevo Platillo</a>
            </div>

            <!-- Filtros -->
            <div class="filter-bar">
                <a asp-action="Platillos" asp-route-idCategoria="" asp-route-busqueda="@busqueda" class="filter-chip @(!idCat.HasValue ? "active" : "")">
                    📋 Todos <span class="chip-count">@Model.TotalRegistros</span>
                </a>
                @foreach (var cat in categorias)
                {
                    <a asp-action="Platillos" asp-route-idCategoria="@cat.IdCategoria" asp-route-busqueda="@busqueda" class="filter-chip @(idCat == cat.IdCategoria ? "active" : "")">
                        @cat.Nombre
                    </a>
                }
            </div>

            <!-- Table -->
            <div class="table-wrapper card">
                <table>
                    <thead>
                        <tr><th>Imagen</th><th>Nombre</th><th>Categoría</th><th>Precio</th><th>En Stock</th><th>Acciones</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr class="@(!p.Disponible ? "row-agotado" : "")">
                                <td>
                                    <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=60" : p.ImagenUrl)"
                                         alt="@p.Nombre"
                                         style="width:52px;height:40px;object-fit:cover;border-radius:6px"
                                         onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=60'" />
                                </td>
                                <td>
                                    <b>@p.Nombre</b>
                                    @if (!p.Disponible)
                                    {
                                        <span class="status-badge badge-agotado">Agotado</span>
                                    }
                                </td>
                                <td><span class="badge badge-gold">@p.NombreCategoria</span></td>
                                <td class="price">S/ @p.Precio.ToString("F2")</td>
                                <td>
                                    <label class="toggle-switch">
                                        <input type="checkbox" @(p.Disponible ? "checked" : "") disabled />
                                        <span class="toggle-slider"></span>
                                    </label>
                                </td>
                                <td style="display:flex;gap:0.5rem">
                                    <a asp-action="EditarPlatillo" asp-route-id="@p.IdPlatillo" class="btn btn-ghost btn-sm" title="Editar">✏️</a>
                                    <form asp-action="EliminarPlatillo" method="post" style="margin:0;" id="formElimP@(p.IdPlatillo)">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.IdPlatillo" />
                                        <button type="button" class="btn btn-ghost btn-sm" style="color:#f44336;border-color:#f44336" title="Eliminar" onclick="confirmarEliminacion('formElimP@(p.IdPlatillo)', '@p.Nombre')">🗑</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted)">No hay platillos en esta categoría</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            @if (Model.TotalPaginas > 1)
            {
                <div style="display:flex;justify-content:center;align-items:center;gap:1rem;margin-top:1.5rem">
                    @if (Model.PaginaActual > 1)
                    {
                        <a asp-action="Platillos" asp-route-pagina="@(Model.PaginaActual - 1)" asp-route-idCategoria="@idCat" asp-route-busqueda="@busqueda" class="btn btn-secondary">Anterior</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Anterior</button>
                    }

                    <span class="text-muted">Página @Model.PaginaActual de @Model.TotalPaginas</span>

                    @if (Model.PaginaActual < Model.TotalPaginas)
                    {
                        <a asp-action="Platillos" asp-route-pagina="@(Model.PaginaActual + 1)" asp-route-idCategoria="@idCat" asp-route-busqueda="@busqueda" class="btn btn-secondary">Siguiente</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Siguiente</button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminacion(formId, nombre) {
            Swal.fire({
                title: 'Eliminar platillo',
                html: `<p class="text-muted" style="margin-bottom:0.25rem">¿Estás seguro de que deseas eliminar</p>
                       <p style="font-weight:700;color:var(--accent-gold);margin-bottom:0.75rem;font-size:1.1rem">"${nombre || 'este platillo'}"?</p>
                       <p class="text-muted" style="font-size:0.82rem;margin-bottom:0">Podrás restaurarlo en cualquier momento desde esta misma tabla.</p>`,
                iconHtml: '<span style="font-size:2.5rem;display:block;">🗑</span>',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#D9381E',
                cancelButtonColor: 'rgba(255,255,255,0.05)',
                background: '#1E1E24',
                color: '#F4F4F6',
                customClass: {
                    popup: 'maido-swal-popup',
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-ghost'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
    </script>
}
