@using Maido.Application.BL.BC.DTOs
@model IEnumerable<UsuarioDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    
    // Función auxiliar para extraer iniciales
    string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpper();
    }
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    
    <div class="admin-content">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem">
            <div>
                <h1 style="margin-bottom:0.25rem">Gestión de <span class="text-accent">Usuarios</span></h1>
                <p class="text-muted">Administra los accesos y estado del personal y clientes</p>
            </div>
        </div>

        <!-- Tabla de Usuarios -->
        <div class="table-wrapper card">
            <table>
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Contacto</th>
                        <th>Rol</th>
                        <th>Registro</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var initials = GetInitials(u.NombreCompleto);
                        
                        <tr>
                            <td>
                                <div class="flex items-center gap-2">
                                    <div class="user-avatar" style="width:34px;height:34px;border-radius:50%;background:var(--accent-red);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.85rem;flex-shrink:0;">
                                        @initials
                                    </div>
                                    <div>
                                        <b>@u.NombreCompleto</b>
                                        <div class="text-muted" style="font-size:0.75rem">ID: #@u.IdUsuario</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-size:0.85rem">✉️ @u.Email</div>
                                <div class="text-muted" style="font-size:0.75rem">📞 @(string.IsNullOrEmpty(u.Telefono) ? "Sin teléfono" : u.Telefono)</div>
                            </td>
                            <td>
                                @if (u.IdRol == 1)
                                {
                                    <span class="badge badge-accent">🛡️ Admin</span>
                                }
                                else
                                {
                                    <span class="badge badge-gold">Cliente</span>
                                }
                            </td>
                            <td class="text-muted" style="font-size:0.85rem">
                                @u.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactivo</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                @if (u.IdRol != 1)
                                {
                                    <form asp-action="ToggleUsuario" method="post" style="margin: 0; display: inline-block;" id="formToggle-@u.IdUsuario">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                        <input type="hidden" name="activo" value="@((!u.Activo).ToString().ToLower())" />
                                        @if (u.Activo)
                                        {
                                            <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger); border-color:var(--danger);" title="Desactivar"
                                                    onclick="confirmarToggleUsuario('formToggle-@u.IdUsuario', '@u.NombreCompleto', false)">
                                                🚫 Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-ghost btn-sm" style="color:#4caf50; border-color:#4caf50;" title="Activar"
                                                    onclick="confirmarToggleUsuario('formToggle-@u.IdUsuario', '@u.NombreCompleto', true)">
                                                ✅ Activar
                                            </button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:0.8rem">Protegido</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted)">No hay usuarios registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarToggleUsuario(formId, nombreUsuario, activando) {
            Swal.fire({
                title: activando ? 'Activar usuario' : 'Desactivar usuario',
                html: activando
                    ? `<p class="text-muted" style="margin-bottom:0.25rem">¿Deseas activar la cuenta de</p>
                       <p style="font-weight:700;color:var(--accent-gold);margin-bottom:0.75rem;font-size:1.1rem">"${nombreUsuario}"?</p>
                       <p class="text-muted" style="font-size:0.82rem;margin-bottom:0">Recuperará acceso a la plataforma.</p>`
                    : `<p class="text-muted" style="margin-bottom:0.25rem">¿Deseas desactivar la cuenta de</p>
                       <p style="font-weight:700;color:var(--accent-gold);margin-bottom:0.75rem;font-size:1.1rem">"${nombreUsuario}"?</p>
                       <p class="text-muted" style="font-size:0.82rem;margin-bottom:0">Perderá acceso a la plataforma.</p>`,
                iconHtml: `<span style="font-size:2.5rem;display:block;">${activando ? '👤' : '🚫'}</span>`,
                showCancelButton: true,
                confirmButtonText: activando ? 'Sí, activar' : 'Sí, desactivar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: activando ? '#4caf50' : '#D9381E',
                cancelButtonColor: 'rgba(255,255,255,0.05)',
                background: '#1E1E24',
                color: '#F4F4F6',
                customClass: {
                    popup: 'maido-swal-popup',
                    confirmButton: activando ? 'btn btn-primary' : 'btn btn-danger',
                    cancelButton: 'btn btn-ghost'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
    </script>
}
