@using Maido.Application.BL.BC.DTOs
@model IEnumerable<UsuarioDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="admin-layout">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Gestión de Usuarios</h2>
            <p class="text-muted">Administra los accesos y estado de los clientes y administradores.</p>
        </div>
    </div>

    <div class="maido-table">
        <table class="table table-dark table-hover mb-0" style="background-color: transparent;">
            <thead>
                <tr>
                    <th>Nombre Completo</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th>Registro</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-bold">@u.NombreCompleto</td>
                        <td class="text-muted">@u.Email</td>
                        <td>@(string.IsNullOrEmpty(u.Telefono) ? "-" : u.Telefono)</td>
                        <td>
                            @if (u.IdRol == 1)
                            {
                                <span class="badge bg-gold text-white border border-gold"><i class="bi bi-shield-lock me-1"></i>Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-25 border border-secondary border-opacity-25">Cliente</span>
                            }
                        </td>
                        <td class="text-muted small">@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (u.IdRol != 1) @* No permitir cambiar estado de admins *@
                            {
                                <form asp-action="ToggleUsuario" method="post" class="d-inline" id="formToggle-@u.IdUsuario">
                                    <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                    <input type="hidden" name="activo" value="@((!u.Activo).ToString().ToLower())" />
                                    @if (u.Activo)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Desactivar"
                                                onclick="confirmarToggleUsuario('formToggle-@u.IdUsuario', '@u.NombreCompleto', false)">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" title="Activar"
                                                onclick="confirmarToggleUsuario('formToggle-@u.IdUsuario', '@u.NombreCompleto', true)">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary disabled" title="Rol protegido"><i class="bi bi-shield-fill-check"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .swal2-popup.maido-swal-popup {
            background: var(--bg-card);
            color: var(--text-primary);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg, 12px);
        }
        .swal2-popup.maido-swal-popup .swal2-title,
        .swal2-popup.maido-swal-popup .swal2-html-container {
            color: var(--text-primary);
        }
    </style>
    <script>
        function confirmarToggleUsuario(formId, nombreUsuario, activando) {
            Swal.fire({
                title: activando ? '¿Activar usuario?' : '¿Desactivar usuario?',
                html: activando
                    ? `<strong>${nombreUsuario}</strong> recuperará el acceso al sistema.`
                    : `<strong>${nombreUsuario}</strong> perderá el acceso al sistema.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: activando ? 'Sí, activar' : 'Sí, desactivar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: activando ? '#2E7D32' : '#dc3545',
                cancelButtonColor: '#6c757d',
                customClass: { popup: 'maido-swal-popup' }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
    </script>
}