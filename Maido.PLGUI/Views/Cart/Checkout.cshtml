@using Maido.Application.BL.BC.DTOs
@model CheckoutDto

@{
    ViewData["Title"] = "Finalizar Compra - Maido";
    var carrito = ViewBag.Carrito as List<Maido.PLGUI.Models.CarritoItem> ?? new List<Maido.PLGUI.Models.CarritoItem>();
    var subtotal = (decimal)(ViewBag.Subtotal ?? 0m);
    var igv = (decimal)(ViewBag.IGV ?? 0m);
    var total = (decimal)(ViewBag.Total ?? 0m);
    var success = ViewBag.Success != null && (bool)ViewBag.Success;
    var pedidoId = ViewBag.PedidoId;
    var userName = Context.Session.GetString("Maido_Nombre") ?? "Cliente";
    var metodoActual = string.IsNullOrEmpty(Model?.MetodoPago) ? "EFECTIVO" : Model.MetodoPago.ToUpper();
}

<div class="checkout-page">
  <div class="container">
    @if (!success)
    {
      <h1 style="margin-bottom:2rem;text-align:center">Finalizar <span class="text-accent">Compra</span></h1>
    }

    <!-- PANTALLA DE ÉXITO -->
    @if (success)
    {
      <div class="success-screen">
        <div class="receipt-card">
          <div class="receipt-header">
            <div class="success-icon">✅</div>
            <h2>¡Pedido Confirmado!</h2>
            <p class="text-muted">Orden #@pedidoId recibida exitosamente</p>
          </div>
          
          <div class="tracker">
            <div class="tracker-step active">
              <div class="dot"></div>
              <div class="label">Recibido</div>
            </div>
            <div class="tracker-step">
              <div class="dot"></div>
              <div class="label">Cocina</div>
            </div>
            <div class="tracker-step">
              <div class="dot"></div>
              <div class="label">En camino</div>
            </div>
          </div>

          <div class="receipt-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al Inicio</a>
            <a asp-controller="Cliente" asp-action="MisPedidos" class="btn btn-ghost" style="color:var(--accent-gold)">Ver estado de mi orden →</a>
          </div>
        </div>
      </div>
    }

    <!-- CHECKOUT NORMAL -->
    @if (!success)
    {
      <div class="checkout-layout">
        
        <!-- COLUMNA IZQUIERDA: FORMULARIO POR PASOS -->
        <div class="checkout-steps">
          <form asp-controller="Cart" asp-action="Checkout" method="post" id="formCheckout">
            @Html.AntiForgeryToken()
            
            <!-- PASO 1: ENTREGA -->
            <div class="step-card card">
              <div class="step-header">
                <span class="step-number">1</span>
                <h3>Datos de Entrega</h3>
              </div>
              <div class="step-body">
                <div class="form-group">
                  <label class="form-label">Nombre completo</label>
                  <input type="text" class="form-input readonly-input" value="@userName" readonly>
                </div>

                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem; margin-bottom:1rem">
                  <div class="form-group" style="margin:0">
                    <label class="form-label">Teléfono *</label>
                    <input type="tel" name="Telefono" class="form-input" value="@Model?.Telefono" placeholder="Ej. 987654321">
                    @Html.ValidationMessage("Telefono", new { @class = "form-error" })
                  </div>
                  <div class="form-group" style="margin:0">
                    <label class="form-label">Dirección de entrega *</label>
                    <input type="text" name="DireccionEntrega" class="form-input" value="@Model?.DireccionEntrega" placeholder="Av. La Mar 700">
                    @Html.ValidationMessage("DireccionEntrega", new { @class = "form-error" })
                  </div>
                </div>

                <div class="form-group" style="margin:0">
                  <label class="form-label">Indicaciones Especiales (opcional)</label>
                  <textarea name="Observaciones" class="form-input" rows="2" placeholder="Tocar el timbre 2 veces, sin rocoto, etc.">@Model?.Observaciones</textarea>
                </div>
              </div>
            </div>

            <!-- PASO 2: PAGO -->
            <div class="step-card card">
              <div class="step-header">
                <span class="step-number">2</span>
                <h3>Método de Pago</h3>
              </div>
              <div class="step-body">
                <div class="payment-methods-grid">
                  <label class="payment-card @(metodoActual == "EFECTIVO" ? "active" : "")" id="labelEfectivo">
                    <input type="radio" name="MetodoPago" value="Efectivo" style="display:none" @(metodoActual == "EFECTIVO" ? "checked" : "") onchange="selectPaymentMethod('EFECTIVO')">
                    <div class="payment-icon">💵</div>
                    <div class="payment-name">Efectivo</div>
                    <div class="payment-desc">Pagas al recibir</div>
                  </label>
                  <label class="payment-card @(metodoActual == "POS" ? "active" : "")" id="labelPOS">
                    <input type="radio" name="MetodoPago" value="POS" style="display:none" @(metodoActual == "POS" ? "checked" : "") onchange="selectPaymentMethod('POS')">
                    <div class="payment-icon">📟</div>
                    <div class="payment-name">POS</div>
                    <div class="payment-desc">Débito/Crédito al recibir</div>
                  </label>
                  <label class="payment-card @(metodoActual == "TARJETA" ? "active" : "")" id="labelTarjeta">
                    <input type="radio" name="MetodoPago" value="Tarjeta" style="display:none" @(metodoActual == "TARJETA" ? "checked" : "") onchange="selectPaymentMethod('TARJETA')">
                    <div class="payment-icon">💳</div>
                    <div class="payment-name">Tarjeta Web</div>
                    <div class="payment-desc">Pago online seguro</div>
                  </label>
                </div>

                <!-- SIMULADOR TARJETA (Glassmorphism) -->
                <div class="card-simulation-wrapper" id="cardSimulation" style="@(metodoActual == "TARJETA" ? "display:block;" : "display:none;")">
                  <div class="glass-card">
                    <div class="card-sim-header">
                      <span class="chip-icon">🖲️</span>
                      <div class="card-brands">
                        <span class="brand visa">VISA</span>
                        <span class="brand mc">MC</span>
                      </div>
                    </div>
                    
                    <div class="form-group" style="margin-bottom:1.5rem">
                      <label style="font-size:0.7rem;text-transform:uppercase;color:rgba(255,255,255,0.6)">Número de Tarjeta</label>
                      <input type="text" class="form-input card-input" id="tarjetaNumero" placeholder="0000 0000 0000 0000" maxlength="19" oninput="formatCardNumber(this)">
                    </div>
                    
                    <div style="display:flex; gap:1.5rem">
                      <div class="form-group" style="flex:1;margin:0">
                        <label style="font-size:0.7rem;text-transform:uppercase;color:rgba(255,255,255,0.6)">Vence</label>
                        <input type="text" class="form-input card-input" id="tarjetaVencimiento" placeholder="MM/YY" maxlength="5">
                      </div>
                      <div class="form-group" style="flex:1;margin:0">
                        <label style="font-size:0.7rem;text-transform:uppercase;color:rgba(255,255,255,0.6)">CVV</label>
                        <input type="password" class="form-input card-input" id="tarjetaCvv" placeholder="•••" maxlength="4">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BOTON CONFIRMAR -->
            <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;margin-top:1rem;font-size:1.1rem">
              Pagar S/ @total.ToString("F2")
            </button>
          </form>
        </div>

        <!-- COLUMNA DERECHA: RESUMEN STICKY -->
        <div class="summary-wrapper">
          <div class="card summary-card sticky">
            <h3 style="margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border)">Resumen de Orden</h3>
            
            <div class="summary-items">
              @foreach (var item in carrito)
              {
                <div class="summary-item">
                  <div class="item-img" style="background-image: url('@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/placeholder.jpg" : item.ImagenUrl)')"></div>
                  <div class="item-info">
                    <span class="item-name">@item.Nombre</span>
                    <span class="item-qty">Cant: @item.Cantidad</span>
                  </div>
                  <div class="item-price">S/ @item.Subtotal.ToString("F2")</div>
                </div>
              }
            </div>

            <div class="summary-totals">
              <div class="order-line text-muted">
                <span>Subtotal</span>
                <span>S/ @subtotal.ToString("F2")</span>
              </div>
              <div class="order-line text-muted">
                <span>IGV (18%)</span>
                <span>S/ @igv.ToString("F2")</span>
              </div>
              <div class="order-line text-muted">
                <span>Envío</span>
                <span style="color:#10b981">¡Gratis!</span>
              </div>
              <hr class="divider">
              <div class="order-line final-total">
                <span>Total a Pagar</span>
                <span class="text-gold">S/ @total.ToString("F2")</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    }
  </div>
</div>

@section Scripts {
    <script>
        function selectPaymentMethod(metodo) {
            document.querySelectorAll('.payment-card').forEach(c => c.classList.remove('active'));
            const cardSim = document.getElementById('cardSimulation');
            
            if (metodo === 'EFECTIVO') {
                document.getElementById('labelEfectivo').classList.add('active');
                if (cardSim) cardSim.style.display = 'none';
            } else if (metodo === 'POS') {
                document.getElementById('labelPOS').classList.add('active');
                if (cardSim) cardSim.style.display = 'none';
            } else if (metodo === 'TARJETA') {
                document.getElementById('labelTarjeta').classList.add('active');
                if (cardSim) cardSim.style.display = 'block';
            }
        }

        function formatCardNumber(input) {
            let val = input.value.replace(/\D/g, '');
            if (val.length > 16) val = val.substring(0, 16);
            let formatted = '';
            for (let i = 0; i < val.length; i++) {
                if (i > 0 && i % 4 === 0) formatted += ' ';
                formatted += val[i];
            }
            input.value = formatted;
        }
    </script>
}
