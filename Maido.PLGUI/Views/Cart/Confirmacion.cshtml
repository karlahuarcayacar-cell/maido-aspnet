@using Maido.Application.BL.BC.DTOs
@model PedidoDetalleDto

@{
    ViewData["Title"] = "Confirmación de Pedido - Maido";
}

<div class="container" style="padding-top: 6rem; padding-bottom: 5rem; max-width: 680px;">
    <div class="card" style="text-align: center; padding: 2.5rem 2rem;">

        <div style="font-size: 3.5rem; margin-bottom: 1rem;">✅</div>

        <h1 style="margin-bottom: 0.5rem;">¡Pedido <span class="text-accent">Confirmado</span>!</h1>
        <p class="text-muted" style="margin-bottom: 2rem;">Tu pedido <b class="text-gold">#@Model.IdPedido</b> ha sido registrado exitosamente.</p>

        <div class="grid-2" style="text-align: left; background: rgba(255,255,255,0.02); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border); margin-bottom: 2rem;">
            <div>
                <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.2rem;">CLIENTE</p>
                <p style="font-weight: 600; margin: 0;">@Model.NombreCliente</p>
            </div>
            <div>
                <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.2rem;">FECHA Y HORA</p>
                <p style="font-weight: 600; margin: 0;">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div>
                <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.2rem;">ENTREGA</p>
                <p style="font-weight: 600; margin: 0;">
                    @if (Model.TipoPedido == "Delivery")
                    {
                        <span>🚴 Delivery</span>
                    }
                    else
                    {
                        <span>🏪 Recojo en local</span>
                    }
                </p>
            </div>
            <div>
                <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.2rem;">MÉTODO DE PAGO</p>
                <p style="font-weight: 600; margin: 0;">@Model.MetodoPago</p>
            </div>
            @if (!string.IsNullOrEmpty(Model.DireccionEntrega))
            {
                <div style="grid-column: span 2;">
                    <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.2rem;">DIRECCIÓN</p>
                    <p style="font-weight: 600; margin: 0;">@Model.DireccionEntrega</p>
                </div>
            }
        </div>

        <div style="text-align: left; margin-bottom: 2rem;">
            <p class="text-muted" style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;">Detalle del pedido</p>
            @foreach (var item in Model.Items)
            {
                <div class="flex justify-between items-center" style="padding: 0.6rem 0; border-bottom: 1px dashed var(--border);">
                    <span>@item.Nombre <span class="text-muted">× @item.Cantidad</span></span>
                    <span class="text-gold" style="font-weight: 600;">S/ @item.Subtotal.ToString("F2")</span>
                </div>
            }

            <div style="margin-top: 1rem;">
                <div class="flex justify-between text-muted" style="font-size: 0.9rem; margin-bottom: 0.3rem;">
                    <span>Subtotal</span><span>S/ @Model.Subtotal.ToString("F2")</span>
                </div>
                <div class="flex justify-between text-muted" style="font-size: 0.9rem; margin-bottom: 0.5rem;">
                    <span>IGV (18%)</span><span>S/ @Model.IGV.ToString("F2")</span>
                </div>
                <div class="flex justify-between" style="font-size: 1.2rem; font-weight: 700;">
                    <span>Total</span>
                    <span class="text-accent">S/ @Model.Total.ToString("F2")</span>
                </div>
            </div>
        </div>

        <div style="margin-bottom: 2rem;">
            <span class="badge badge-success">@Model.Estado</span>
        </div>

        <div class="flex gap-2 justify-center" style="flex-wrap: wrap;">
            <a asp-controller="Cliente" asp-action="MisPedidos" class="btn btn-secondary">
                📋 Mis Pedidos
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                🍣 Seguir Comprando
            </a>
        </div>

    </div>
</div>
