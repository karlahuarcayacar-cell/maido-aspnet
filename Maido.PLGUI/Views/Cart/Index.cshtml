@using Maido.Application.BL.BC.DTOs
@using Maido.PLGUI.Models
@{
    ViewData["Title"] = "Tu Pedido - Maido";
    var carrito = ViewBag.Carrito as List<CarritoItem> ?? new List<CarritoItem>();
    var subtotal = (decimal)ViewBag.Subtotal;
    var igv = (decimal)ViewBag.IGV;
    var total = (decimal)ViewBag.Total;
    var sugerencias = ViewBag.Sugerencias as IEnumerable<PlatilloDto> ?? new List<PlatilloDto>();
}

<style>
    .accent-line {
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, var(--accent) 0%, var(--gold) 100%);
    }
    .glass-card {
        background: rgba(30, 30, 36, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
    }
    .nikkei-glow-red {
        box-shadow: 0 6px 20px rgba(217, 56, 30, 0.4);
    }
    .item-img {
        width: 120px;
        height: 120px;
        flex-shrink: 0;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border-subtle);
    }
    .sug-img {
        width: 64px;
        height: 64px;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid var(--border-subtle);
    }
    .qty-control-box {
        display: flex;
        align-items: center;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius);
        background: var(--bg-card);
        padding: 0 0.5rem;
    }
    .btn-qty {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 0.5rem;
        transition: color 0.2s;
    }
    .btn-qty:hover {
        color: var(--accent);
    }

</style>

<div class="container page-transition" style="margin-top: 5rem; margin-bottom: 5rem;">
    <!-- Title Section -->
    <header class="mb-5">
        <h1 class="display-font fs-1 text-white mb-2 fw-bold">Tu Pedido</h1>
        <div class="accent-line"></div>
    </header>

    <div class="row g-5">
        <!-- Product List -->
        <section class="col-lg-8">
            <div class="d-flex flex-column gap-4" id="cart-items-container">
                @if (!carrito.Any())
                {
                    <div class="glass-card p-5 text-center text-muted">
                        <i class="bi bi-bag-x fs-1 mb-3 d-block"></i>
                        <h5>Tu carrito está vacío</h5>
                        <a href="/Home/Menu" class="btn btn-outline-accent mt-3">Explorar Menú</a>
                    </div>
                }
                else
                {
                    foreach (var item in carrito)
                    {
                        <div class="glass-card p-4 d-flex flex-column flex-md-row gap-4 align-items-center transition-all item-row" id="row-@item.IdPlatillo">
                            <div class="item-img">
                                <img src="@item.ImagenUrl" alt="@item.Nombre" class="w-100 h-100" style="object-fit: cover;" />
                            </div>
                            <div class="flex-grow-1 text-center text-md-start">
                                <h3 class="fs-5 text-white mb-1 fw-semibold display-font">@item.Nombre</h3>
                                <p class="text-muted small mb-0">Deliciosa preparación estilo Nikkei Noir.</p>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="qty-control-box">
                                    <button class="btn-qty" onclick="actualizarQty(@item.IdPlatillo, @(item.Cantidad - 1))">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <span class="px-3 fw-bold display-font" id="qty-val-@item.IdPlatillo">@item.Cantidad</span>
                                    <button class="btn-qty" onclick="actualizarQty(@item.IdPlatillo, @(item.Cantidad + 1))">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="text-end" style="min-width: 100px;">
                                <span class="d-block text-gold fw-bold display-font fs-5" id="subt-val-@item.IdPlatillo">S/ @item.Subtotal.ToString("F2")</span>
                                <button class="btn btn-link text-muted hover-accent text-decoration-none p-0 mt-2 d-flex align-items-center gap-1 ms-auto" onclick="removerItem(@item.IdPlatillo)">
                                    <i class="bi bi-trash3"></i> <span style="font-size: 0.75rem; letter-spacing:1px;" class="text-uppercase fw-bold">Quitar</span>
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Suggestions Section -->
            @if (sugerencias.Any())
            {
                <div class="mt-5 pt-4 border-top border-subtle">
                    <h2 class="fs-5 text-white mb-4 d-flex align-items-center gap-2 display-font">
                        <i class="bi bi-stars text-accent"></i>
                        También podría gustarte
                    </h2>
                    <div class="row g-4">
                        @foreach (var sug in sugerencias)
                        {
                            <div class="col-md-6">
                                <div class="glass-card p-3 d-flex gap-3 align-items-center">
                                    <div class="sug-img">
                                        <img src="@sug.ImagenUrl" alt="@sug.Nombre" class="w-100 h-100" style="object-fit:cover;" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0 fs-6 text-white text-uppercase" style="font-size:0.85rem; letter-spacing:1px;">@sug.Nombre</h4>
                                        <span class="text-gold display-font fw-bold">S/ @sug.Precio.ToString("F2")</span>
                                    </div>
                                    <button class="btn btn-outline-accent rounded-circle" style="width:40px; height:40px; padding:0;" onclick="agregarAlCarrito(@sug.IdPlatillo, 1)">
                                        <i class="bi bi-plus fs-5"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Order Summary Sidebar -->
        <aside class="col-lg-4">
            <div class="glass-card p-4 position-sticky" style="top: 100px; z-index: 1010;">
                <h2 class="fs-4 text-white mb-4 display-font fw-bold">Resumen</h2>
                
                <div class="d-flex flex-column gap-3 mb-4 border-bottom border-subtle pb-4">
                    <div class="d-flex justify-content-between text-muted">
                        <span>Subtotal</span>
                        <span class="display-font fw-bold text-white" id="resumen-subtotal">S/ @subtotal.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted">
                        <span>IGV (18%)</span>
                        <span class="display-font fw-bold text-white" id="resumen-igv">S/ @igv.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2">
                        <span class="fs-5 fw-bold text-white display-font">Total</span>
                        <span class="text-gold display-font fs-4 fw-bold" id="resumen-total">S/ @total.ToString("F2")</span>
                    </div>
                </div>

                <a href="@(carrito.Any() ? "/Cart/Checkout" : "#")" class="btn btn-accent w-100 py-3 text-uppercase fw-bold nikkei-glow-red d-flex align-items-center justify-content-center gap-2 @(!carrito.Any() ? "disabled" : "")">
                    Proceder al Pago
                    <i class="bi bi-arrow-right"></i>
                </a>

                <div class="mt-4 d-flex justify-content-center align-items-center gap-2 text-muted">
                    <i class="bi bi-lock-fill"></i>
                    <span style="font-size: 10px; letter-spacing:1px;" class="fw-bold">PAGO 100% SEGURO Y CIFRADO</span>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        async function actualizarQty(idPlatillo, nuevaCantidad) {
            if (nuevaCantidad <= 0) {
                removerItem(idPlatillo);
                return;
            }
            
            try {
                const res = await fetch('/Cart/ActualizarCantidad', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPlatillo, cantidad: nuevaCantidad })
                });
                const data = await res.json();
                if (data.success) {
                    // Update header badge
                    actualizarBadge(data.totalItems);
                    
                    // Update item row
                    document.getElementById('qty-val-' + idPlatillo).textContent = nuevaCantidad;
                    // Note: Since ActualizarCantidad doesn't return the item subtotal, we need to reload or calculate
                    location.reload(); 
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function removerItem(idPlatillo) {
            try {
                const res = await fetch('/Cart/EliminarItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPlatillo })
                });
                const data = await res.json();
                if (data.success) {
                    location.reload(); 
                }
            } catch (e) {
                console.error(e);
            }
        }
    </script>
}
