@using Maido.Application.BL.BC.DTOs
@using Maido.PLGUI.Models
@{
    ViewData["Title"] = "Mi Carrito - Maido";
    var carrito = ViewBag.Carrito as List<CarritoItem> ?? new List<CarritoItem>();
    var subtotal = (decimal)(ViewBag.Subtotal ?? 0m);
    var igv = (decimal)(ViewBag.IGV ?? 0m);
    var total = (decimal)(ViewBag.Total ?? 0m);
    var sugerencias = ViewBag.Sugerencias as IEnumerable<PlatilloDto> ?? new List<PlatilloDto>();
}

<div class="carrito-page">
    <div class="container">
        <h1 style="margin-bottom:0.5rem">🛒 Mi <span class="text-accent">Carrito</span></h1>
        <p class="text-muted" style="margin-bottom:2.5rem" id="items-count-text">@carrito.Count @(carrito.Count == 1 ? "platillo" : "platillos") seleccionados</p>

        @if (!carrito.Any())
        {
            <div class="empty-cart" id="empty-cart-msg">
                <p style="font-size:4rem">🍱</p>
                <h3>Tu carrito está vacío</h3>
                <p class="text-muted">Explora nuestro menú y agrega platillos</p>
                <a asp-controller="Home" asp-action="Menu" class="btn btn-primary" style="margin-top:1.5rem">Ver Menú</a>
            </div>
        }
        else
        {
            <div class="cart-layout" id="cart-content-layout">
                <!-- Items -->
                <div class="cart-items" id="cart-items-container">
                    @foreach (var item in carrito)
                    {
                        <div class="cart-item card" id="grid-layout-@item.IdPlatillo">
                            <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=200" : item.ImagenUrl)"
                                 alt="@item.Nombre" class="item-img" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=200'">
                            <div class="item-info">
                                <h4>@item.Nombre</h4>
                                <p class="price">S/ @item.Precio.ToString("F2")</p>
                            </div>
                            <div class="item-qty">
                                <button type="button" class="qty-btn" onclick="actualizarQtyLocal(@item.IdPlatillo, @(item.Cantidad - 1), @item.Precio)" id="button-minus-@item.IdPlatillo" aria-label="Disminuir">&minus;</button>
                                <span class="qty-num" id="qty-val-@item.IdPlatillo">@item.Cantidad</span>
                                <button type="button" class="qty-btn" onclick="actualizarQtyLocal(@item.IdPlatillo, @(item.Cantidad + 1), @item.Precio)" id="button-plus-@item.IdPlatillo" aria-label="Aumentar">+</button>
                            </div>
                            <div class="item-total">
                                <p class="price" id="subt-val-@item.IdPlatillo">S/ @item.Subtotal.ToString("F2")</p>
                                <button class="btn btn-ghost btn-sm" onclick="removerItemLocal(@item.IdPlatillo)" style="color:#f44336;border-color:#f44336">🗑</button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Resumen -->
                <div class="cart-summary card card-body">
                    <h3 style="margin-bottom:1.5rem">Resumen del Pedido</h3>
                    <div id="summary-rows-container">
                        @foreach (var item in carrito)
                        {
                            <div class="summary-row" id="summary-row-@item.IdPlatillo">
                                <span class="text-muted">@item.Nombre x<span id="summary-qty-@item.IdPlatillo">@item.Cantidad</span></span>
                                <span id="summary-subt-@item.IdPlatillo">S/ @item.Subtotal.ToString("F2")</span>
                            </div>
                        }
                    </div>
                    <hr class="divider" style="margin: 1rem 0;">
                    <div class="summary-row text-muted" style="font-size:0.9rem">
                        <span>Subtotal</span>
                        <span id="resumen-subtotal">S/ @subtotal.ToString("F2")</span>
                    </div>
                    <div class="summary-row text-muted" style="font-size:0.9rem">
                        <span>IGV (18%)</span>
                        <span id="resumen-igv">S/ @igv.ToString("F2")</span>
                    </div>
                    <hr class="divider divider-gold">
                    <div class="summary-row summary-total">
                        <span>Total</span>
                        <span class="price" style="font-size:1.3rem" id="resumen-total">S/ @total.ToString("F2")</span>
                    </div>
                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:1.5rem" id="button-proceder-pago">
                        Completar mi pedido →
                    </a>
                    <button class="btn btn-ghost" style="width:100%;justify-content:center;margin-top:0.75rem" onclick="vaciarCarritoLocal()">
                        Vaciar carrito
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function updateCartCountText(totalItems) {
            const countElem = document.getElementById('items-count-text');
            if (countElem) {
                countElem.textContent = `${totalItems} ${totalItems === 1 ? 'platillo' : 'platillos'} seleccionados`;
            }
        }

        function setDOMResumen(subtotal, igv, total) {
            const subtotalElem = document.getElementById('resumen-subtotal');
            if (subtotalElem) subtotalElem.textContent = `S/ ${subtotal.toFixed(2)}`;

            const igvElem = document.getElementById('resumen-igv');
            if (igvElem) igvElem.textContent = `S/ ${igv.toFixed(2)}`;

            const totalElem = document.getElementById('resumen-total');
            if (totalElem) totalElem.textContent = `S/ ${total.toFixed(2)}`;

            const button = document.getElementById('button-proceder-pago');
            if (button) {
                if (total <= 0) {
                    button.classList.add('disabled');
                    button.removeAttribute('href');
                } else {
                    button.classList.remove('disabled');
                    button.setAttribute('href', '/Cart/Checkout');
                }
            }
        }

        async function actualizarQtyLocal(idPlatillo, nuevaCantidad, precio) {
            if (nuevaCantidad <= 0) {
                await removerItemLocal(idPlatillo);
                return;
            }
            
            try {
                const res = await fetch('/Cart/ActualizarCantidad', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPlatillo, cantidad: nuevaCantidad })
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof actualizarBadge === 'function') {
                        actualizarBadge(data.totalItems);
                    }
                    updateCartCountText(data.totalItems);
                    
                    const qtyVal = document.getElementById('qty-val-' + idPlatillo);
                    if (qtyVal) qtyVal.textContent = nuevaCantidad;

                    const itemSubtotal = nuevaCantidad * precio;
                    const subtVal = document.getElementById('subt-val-' + idPlatillo);
                    if (subtVal) subtVal.textContent = `S/ ${itemSubtotal.toFixed(2)}`;

                    const summaryQty = document.getElementById('summary-qty-' + idPlatillo);
                    if (summaryQty) summaryQty.textContent = nuevaCantidad;

                    const summarySubt = document.getElementById('summary-subt-' + idPlatillo);
                    if (summarySubt) summarySubt.textContent = `S/ ${itemSubtotal.toFixed(2)}`;

                    setDOMResumen(data.subtotal, data.igv, data.total);

                    const itemElem = document.getElementById('grid-layout-' + idPlatillo);
                    if (itemElem) {
                        const minusBtn = itemElem.querySelector('.item-qty .qty-btn:first-child');
                        const plusBtn = itemElem.querySelector('.item-qty .qty-btn:last-child');
                        if (minusBtn) minusBtn.setAttribute('onclick', `actualizarQtyLocal(${idPlatillo}, ${nuevaCantidad - 1}, ${precio})`);
                        if (plusBtn) plusBtn.setAttribute('onclick', `actualizarQtyLocal(${idPlatillo}, ${nuevaCantidad + 1}, ${precio})`);
                    }
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function removerItemLocal(idPlatillo) {
            const itemElem = document.getElementById('grid-layout-' + idPlatillo);
            const summaryRow = document.getElementById('summary-row-' + idPlatillo);
            
            if (itemElem) {
                itemElem.style.opacity = '0';
                itemElem.style.transform = 'scale(0.95)';
                itemElem.style.transition = 'all 0.3s ease';
            }

            try {
                const res = await fetch('/Cart/EliminarItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPlatillo })
                });
                const data = await res.json();
                if (data.success) {
                    setTimeout(() => {
                        if (itemElem) itemElem.remove();
                        if (summaryRow) summaryRow.remove();
                        if (typeof actualizarBadge === 'function') {
                            actualizarBadge(data.totalItems);
                        }
                        updateCartCountText(data.totalItems);
                        setDOMResumen(data.subtotal || 0, data.igv || 0, data.total || 0);

                        if (data.totalItems === 0) {
                            const container = document.querySelector('.carrito-page .container');
                            if (container) {
                                container.innerHTML = `
                                    <h1 style="margin-bottom:0.5rem">🛒 Mi <span class="text-accent">Carrito</span></h1>
                                    <p class="text-muted" style="margin-bottom:2.5rem">0 platillos seleccionados</p>
                                    <div class="empty-cart" id="empty-cart-msg">
                                        <p style="font-size:4rem">🍱</p>
                                        <h3>Tu carrito está vacío</h3>
                                        <p class="text-muted">Explora nuestro menú y agrega platillos</p>
                                        <a href="/Home/Menu" class="btn btn-primary" style="margin-top:1.5rem">Ver Menú</a>
                                    </div>
                                `;
                            }
                        }
                    }, 300);
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function vaciarCarritoLocal() {
            const itemElems = document.querySelectorAll('[id^="grid-layout-"]');
            for (const item of itemElems) {
                const id = parseInt(item.id.replace('grid-layout-', ''));
                await fetch('/Cart/EliminarItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPlatillo: id })
                });
            }
            if (typeof actualizarBadge === 'function') {
                actualizarBadge(0);
            }
            const container = document.querySelector('.carrito-page .container');
            if (container) {
                container.innerHTML = `
                    <h1 style="margin-bottom:0.5rem">🛒 Mi <span class="text-accent">Carrito</span></h1>
                    <p class="text-muted" style="margin-bottom:2.5rem">0 platillos seleccionados</p>
                    <div class="empty-cart" id="empty-cart-msg">
                        <p style="font-size:4rem">🍱</p>
                        <h3>Tu carrito está vacío</h3>
                        <p class="text-muted">Explora nuestro menú y agrega platillos</p>
                        <a href="/Home/Menu" class="btn btn-primary" style="margin-top:1.5rem">Ver Menú</a>
                    </div>
                `;
            }
        }
    </script>
}
