@using Maido.Application.BL.BC.DTOs
@model IEnumerable<PedidoResumenDto>

@{
    ViewData["Title"] = "Mis Pedidos - Maido";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="mb-0">Mis Pedidos</h1>
            <p class="text-muted mb-0">Historial de tus pedidos en Maido</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-accent">
            <i class="bi bi-plus-lg me-2"></i>Nuevo Pedido
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="maido-table">
            <table class="table table-dark table-hover mb-0" style="background-color: transparent;">
                <thead>
                    <tr>
                        <th># Pedido</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Pago</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold text-gold">#@p.IdPedido</td>
                            <td class="text-muted">@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (p.TipoPedido == "Delivery")
                                {
                                    <span><i class="bi bi-bicycle me-1 text-accent"></i>Delivery</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-shop me-1 text-gold"></i>Recojo</span>
                                }
                            </td>
                            <td class="text-muted">@p.MetodoPago</td>
                            <td class="fw-bold text-accent">S/ @p.Total.ToString("F2")</td>
                            <td>
                                <span class="badge-estado badge-@p.Estado.Replace(" ", ".")">@p.Estado</span>
                            </td>
                            <td>
                                <a asp-controller="Cart" asp-action="Confirmacion" asp-route-id="@p.IdPedido"
                                   class="btn btn-sm btn-outline-accent">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-receipt-cutoff"></i>
            <h4>Aún no tienes pedidos</h4>
            <p class="text-muted">Explora nuestro menú y haz tu primer pedido Nikkei.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-2">
                <i class="bi bi-grid-fill me-2"></i>Ver Menú
            </a>
        </div>
    }
</div>
