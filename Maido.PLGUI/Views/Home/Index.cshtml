@using Maido.Application.BL.BC.DTOs
@model IEnumerable<PlatilloDto>

@{
    ViewData["Title"] = "Inicio";
}



<!-- Hero Section -->
<section class="hero-section position-relative">
    <div class="hero-bg">
        <div class="hero-overlay"></div>
        <div id="heroCarousel" class="carousel slide carousel-fade h-100" data-bs-ride="carousel" data-bs-pause="false">
            <div class="carousel-inner h-100">
                <div class="carousel-item active h-100" data-bs-interval="4000">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBynxZMhMKZJsDf_ynyNQF9Dm3DFgtdqSAx3tqjIYOscup03vhGFl_cRrQ1n48GIiCygWlna4HyCb2dY2qFHabmqrVeQe4O6YKeAb4ZwuVSB410Ac6HoMQue6aEglYb9F8SRyrNKm9ePTW-AjDuNqGVQJ_sYDBLQJaqb-PJArjL1wyIiBEy-ximoDYTHMU3yWaLYj4FR9ZKT6w_I5ccUy2bsgK0aOr_mnS3eJzDd2zU95F0GLNbLDViaCF0oWwE5eXOJWTwgZvae5I" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(0.8);" alt="Sushi Nikkei">
                </div>
                <div class="carousel-item h-100" data-bs-interval="4000">
                    <img src="https://images.unsplash.com/photo-1579871494447-9811cf80d66c?q=80&w=2000&auto=format&fit=crop" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(0.8);" alt="Sushi spread">
                </div>
                <div class="carousel-item h-100" data-bs-interval="4000">
                    <img src="https://images.unsplash.com/photo-1553621042-f6e147245754?q=80&w=2000&auto=format&fit=crop" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(0.8);" alt="Fine dining sushi">
                </div>
                <div class="carousel-item h-100" data-bs-interval="4000">
                    <img src="https://images.unsplash.com/photo-1611143669185-af224c5e3252?q=80&w=2000&auto=format&fit=crop" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(0.8);" alt="Sushi plate">
                </div>
            </div>
        </div>
    </div>
    
    <div class="container hero-content">
        <div class="row">
            <div class="col-lg-8 col-xl-7">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="text-gold fw-bold text-uppercase" style="letter-spacing: 0.15em; font-size: 0.85rem;">間道 — RESTAURANTE NIKKEI</span>
                </div>
                
                <h1 class="hero-title text-white mb-4 display-font">
                    <span class="d-block">Alta Cocina</span>
                    <span class="d-block text-accent">Peruano-Japonesa</span>
                </h1>
                
                <p class="lead text-secondary mb-5" style="max-width: 500px;">
                    Fusión única entre la gastronomía peruana y japonesa. Ingredientes frescos, sabores únicos, experiencia Nikkei del más alto nivel.
                </p>
                
                <div class="d-flex flex-wrap gap-3 pt-2">
                    <a asp-action="Menu" class="btn btn-accent btn-lg px-4 py-3 fw-bold shadow-glow" style="letter-spacing: 1px; font-size: 0.9rem; text-transform: uppercase;">
                        Ver Menú Completo
                    </a>
                    <a href="#historia" class="btn btn-outline-gold btn-lg px-4 py-3 fw-bold" style="letter-spacing: 1px; font-size: 0.9rem; text-transform: uppercase;">
                        Nuestra Historia
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section py-5 position-relative">
    <div class="container">
        <div class="row text-center text-md-start gy-4">
            <div class="col-md-4">
                <div class="stats-number">15+</div>
                <div class="text-uppercase text-muted fw-bold mt-2" style="letter-spacing: 0.1em; font-size: 0.85rem;">Años de excelencia</div>
            </div>
            <div class="col-md-4">
                <div class="stats-number">50+</div>
                <div class="text-uppercase text-muted fw-bold mt-2" style="letter-spacing: 0.1em; font-size: 0.85rem;">Platillos únicos</div>
            </div>
            <div class="col-md-4">
                <div class="stats-number d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                    #1 <i class="bi bi-graph-up-arrow fs-3 text-gold"></i>
                </div>
                <div class="text-uppercase text-muted fw-bold mt-2" style="letter-spacing: 0.1em; font-size: 0.85rem;">Restaurante Nikkei</div>
            </div>
        </div>
    </div>
</section>

<!-- Menu Preview Section -->
<section class="py-5 my-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-font text-white mb-2" style="font-size: 2.5rem;">Nuestro <span class="text-accent">Menú</span></h2>
            <div class="accent-line mx-auto mb-4" style="width: 60px; height: 3px; background: linear-gradient(90deg, var(--accent-red) 0%, var(--accent-gold) 100%);"></div>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Los mejores platillos de la fusión Nikkei, preparados con ingredientes frescos del día por manos expertas.
            </p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
            @foreach (var p in Model)
            {
                <div class="col">
                    <article class="card maido-card h-100 border-subtle">
                        <div class="product-card-img">
                            <img src="@p.ImagenUrl" alt="@p.Nombre" loading="lazy" />
                            @if (p.Destacado)
                            {
                                <div class="position-absolute top-0 start-0 m-3 z-3">
                                    <span class="badge bg-accent px-2 py-1 text-uppercase fw-bold shadow" style="font-size: 0.65rem; letter-spacing: 1px;">Signature</span>
                                </div>
                            }
                        </div>
                        
                        <div class="card-body d-flex flex-column p-4">
                            <h3 class="display-font fs-5 text-white mb-2">@p.Nombre</h3>
                            <p class="text-muted small flex-grow-1 mb-4" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @p.Descripcion
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="text-gold fw-bold fs-5" style="font-family: var(--font-main);">S/ @p.Precio.ToString("F2")</span>
                                <button class="btn btn-accent btn-sm px-3 py-2 text-uppercase fw-bold shadow-glow" 
                                        style="font-size: 0.75rem;"
                                        onclick="agregarAlCarrito(@p.IdPlatillo, 1)">
                                    Agregar
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
        
        <div class="text-center mt-5 pt-4">
            <a asp-action="Menu" class="btn btn-outline-secondary px-5 py-3 fw-bold text-uppercase group" style="letter-spacing: 1px; font-size: 0.9rem;">
                Explorar el menú completo <i class="bi bi-arrow-right ms-2 text-accent"></i>
            </a>
        </div>
    </div>
</section>

<!-- Delivery Section -->
<section class="delivery-section py-5 my-5 position-relative">
    <div class="delivery-bg"></div>
    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBgJO9tgt4bVNYiUv1pXpAmkKeD_AsrCAfcz-gX8sRS1wdfkXA8QZqM-0bhmeBSTh2T1nJxcFqK1yH0_TzCfEzxs2QoZOin8AtFq9Nr-up1TNjAdY-2ZG_rcN4bJJaz4lV44BEhIX7Hu0iTsHlQydjAyuFgYVEkufR6sM2qobbacWeM3VaWpjtiFwWUXG82GYYKk7ZVvvwXm-EuXld8PqBgho-OcKhFT0ClVKAuuyqe639mcO9VqTL3X4vqJ7_ynUpftHIyqBAZOGo" alt="Delivery Kitchen" loading="lazy">
    
    <div class="container py-4">
        <div class="delivery-card p-4 p-md-5 d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
            <div class="text-center text-md-start">
                <h2 class="display-font text-white mb-3" style="font-size: 2.5rem;">Delivery en <span class="text-gold">Lima</span></h2>
                <p class="text-secondary mb-0" style="max-width: 500px;">
                    Recibe los sabores exclusivos de Maido en la comodidad de tu hogar. Pedidos disponibles todos los días con empaques diseñados para mantener la frescura Nikkei.
                </p>
            </div>
            <div>
                <a asp-action="Menu" class="btn btn-accent btn-lg px-5 py-4 fw-bold d-flex align-items-center gap-3 shadow-glow" style="font-size: 1.1rem; text-transform: uppercase;">
                    <i class="bi bi-bicycle fs-4"></i> Pedir Ahora
                </a>
            </div>
        </div>
    </div>
</section>
