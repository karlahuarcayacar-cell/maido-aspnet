@using Maido.Application.BL.BC.DTOs
@using Maido.PLGUI.Helpers
@model IEnumerable<PlatilloDto>

@{
    ViewData["Title"] = "Menú - Maido";
    ViewData["Description"] = "Explora el menú de cocina Nikkei de Maido. Entradas, Rolls, Platos de Fondo, Postres y Bebidas.";
    var categorias = ViewBag.Categorias as IEnumerable<CategoriaDto> ?? [];
    var idCatActual = ViewBag.IdCategoriaActual as int?;
    var busqueda = ViewBag.Busqueda as string;
}

<div class="catalogo-page">
    <div class="cat-header">
        <div class="container">
            <h1>Nuestro <span class="text-accent">Menú</span></h1>
            <p class="text-muted">Descubre toda la experiencia Nikkei de Maido</p>
        </div>
    </div>

    <div class="container" style="padding-top:2rem; padding-bottom:4rem">
        <div class="filters-bar">
            <form id="formBusqueda" asp-controller="Home" asp-action="Menu" method="get" class="search-wrap">
                <input type="hidden" name="idCategoria" value="@idCatActual" />
                <span class="search-icon">🔍</span>
                <input type="text" name="busqueda" class="form-input search-input" placeholder="Buscar platillo..."
                       value="@busqueda" id="inputBusqueda" oninput="filtrarInstantaneo()">
            </form>
            <div class="cats-scroll">
                <button class="cat-chip @(idCatActual == null && string.IsNullOrEmpty(busqueda) ? "active" : "")" onclick="cambiarCategoria(null, this)">Todos</button>
                @foreach (var cat in categorias)
                {
                    <button class="cat-chip @(idCatActual == cat.IdCategoria ? "active" : "")" onclick="cambiarCategoria(@cat.IdCategoria, this)">
                        @cat.Nombre
                    </button>
                }
            </div>
        </div>

        <div id="contenedor-grilla">
            @await Html.PartialAsync("_PlatillosGrid", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentIdCategoria = @(idCatActual.HasValue ? idCatActual.Value.ToString() : "null");
        let searchTimeout = null;

        function cambiarCategoria(idCat, elemento) {
            currentIdCategoria = idCat;
            document.querySelectorAll('.button-categoria').forEach(button => {
                button.classList.remove('button-primary');
                button.classList.add('button-ghost');
            });
            elemento.classList.remove('button-ghost');
            elemento.classList.add('button-primary');
            document.getElementById('inputBusqueda').value = '';
            ejecutarFiltro();
        }

        function filtrarInstantaneo() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                ejecutarFiltro();
            }, 350);
        }

        function ejecutarFiltro() {
            const busqueda = document.getElementById('inputBusqueda').value;
            const contenedor = document.getElementById('contenedor-grilla');
            let url = '/Home/FiltrarMenu?';
            if (currentIdCategoria) url += 'idCategoria=' + currentIdCategoria + '&';
            if (busqueda) url += 'busqueda=' + encodeURIComponent(busqueda);

            window.history.replaceState({}, '', '/Home/Menu?' + (url.split('?')[1] || ''));

            fetch(url)
                .then(res => res.text())
                .then(html => {
                    contenedor.innerHTML = html;
                })
                .catch(err => {
                    console.error('Error fetching menu:', err);
                    contenedor.innerHTML = '<div style="color: var(--danger);">Ocurrió un error cargando el menú.</div>';
                });
        }
        document.getElementById('formBusqueda').addEventListener('submit', function(e) {
            e.preventDefault();
            filtrarInstantaneo();
        });
    </script>
}
