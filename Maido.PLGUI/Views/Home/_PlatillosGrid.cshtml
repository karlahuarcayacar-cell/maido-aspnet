@using Maido.Application.BL.BC.DTOs
@model IEnumerable<PlatilloDto>

@{
    var esAdmin = ViewBag.EsAdmin as bool? ?? false;
}

@if (Model != null && Model.Any())
{
    <div class="grid-4">
        @foreach (var p in Model)
        {
            <div class="card platillo-card">
                <div class="card-img-wrap">
                    <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400" : p.ImagenUrl)"
                         alt="@p.Nombre" class="card-img" loading="lazy">
                    <span class="card-cat badge badge-gold">@p.NombreCategoria</span>
                    @if (!p.Disponible)
                    {
                        <span class="badge badge-danger" style="position:absolute;top:0.75rem;right:0.75rem">Agotado</span>
                    }
                </div>
                <div class="card-body">
                    <h3 class="card-title">@p.Nombre</h3>
                    <p class="card-desc text-muted">@p.Descripcion</p>
                    <div class="card-footer">
                        <span class="price">S/ @p.Precio.ToString("F2")</span>
                        @if (!esAdmin)
                        {
                            <button class="btn btn-primary btn-sm"
                                    disabled="@(!p.Disponible)"
                                    onclick="agregarAlCarrito(@p.IdPlatillo, 1)">
                                @(p.Disponible ? "+ Agregar" : "Agotado")
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <p style="font-size:3rem">🍱</p>
        <h3>No se encontraron platillos</h3>
        <p class="text-muted">Intenta con otra búsqueda o categoría</p>
    </div>
}
