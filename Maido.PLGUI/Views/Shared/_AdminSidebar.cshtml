@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var nombre = Context.Session.GetString("Maido_Nombre") ?? "Admin";
    var inicial = nombre.Length > 0 ? nombre.Substring(0, 1).ToUpper() : "A";
}

<aside class="sidebar">
    <div class="sidebar-logo">
        <span class="logo-jp display-font" style="font-size:1.6rem;color:var(--accent-gold)">間道</span>
        <span class="logo-text" style="font-size:0.9rem;font-weight:800;letter-spacing:0.15em;margin-left:0.4rem">ADMIN</span>
    </div>
    <nav class="sidebar-nav">
        <a asp-controller="Admin" asp-action="Dashboard" class="@(action == "Dashboard" ? "active" : "")">
            <span class="icon">📊</span> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Platillos" class="@(action.StartsWith("Platillo") ? "active" : "")">
            <span class="icon">🍣</span> Platillos
        </a>
        <a asp-controller="Admin" asp-action="Categorias" class="@(action.StartsWith("Categor") ? "active" : "")">
            <span class="icon">🏷️</span> Categorías
        </a>
        <a asp-controller="Admin" asp-action="Pedidos" class="@(action.StartsWith("Pedido") ? "active" : "")">
            <span class="icon">📋</span> Pedidos
        </a>
        <a asp-controller="Admin" asp-action="Usuarios" class="@(action == "Usuarios" ? "active" : "")">
            <span class="icon">👥</span> Usuarios
        </a>
        <a asp-controller="Admin" asp-action="Reportes" class="@(action == "Reportes" ? "active" : "")">
            <span class="icon">📈</span> Reportes
        </a>
        <hr class="divider">
        <a asp-controller="Home" asp-action="Index" style="color:var(--text-dim)">
            <span class="icon">🏠</span> Ver Sitio
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-logout">
                <span class="icon">🚪</span> Cerrar Sesión
            </button>
        </form>
    </nav>
    <div class="sidebar-user">
        <div class="user-avatar-sm">@inicial</div>
        <div>
            <p style="font-size:0.85rem;font-weight:600;margin:0;">@nombre</p>
            <p class="text-muted" style="font-size:0.75rem;margin:0;">Administrador</p>
        </div>
    </div>
</aside>

