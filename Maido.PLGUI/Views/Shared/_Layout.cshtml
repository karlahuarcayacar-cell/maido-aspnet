<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Maido Restaurante</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Maido - Cocina Nikkei Peruano-Japonesa. Pedidos en línea, delivery y recojo en local.")">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts: Outfit & Noto Serif JP -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/maido.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ══════════════════════════════════════════════════════
     NAVBAR
════════════════════════════════════════════════════════ -->
<nav class="navbar navbar-expand-lg maido-navbar sticky-top">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <span class="brand-logo">鮨</span>
            <span class="brand-text">MAIDO</span>
        </a>

        <!-- Toggler mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <i class="bi bi-grid-3x3-gap text-light fs-5"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <!-- Nav links -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Menu">
                        <i class="bi bi-grid-fill me-1"></i>Menú
                    </a>
                </li>

                @if (Context.Session.GetInt32("Maido_IdRol") == 1)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-gear-fill me-1"></i>Administración
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark maido-dropdown">
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Platillos"><i class="bi bi-egg-fried me-2"></i>Platillos</a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categorias"><i class="bi bi-tags me-2"></i>Categorías</a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Pedidos"><i class="bi bi-receipt me-2"></i>Pedidos</a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people me-2"></i>Usuarios</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reportes"><i class="bi bi-bar-chart me-2"></i>Reportes</a></li>
                        </ul>
                    </li>
                }

                @if (Context.Session.GetInt32("Maido_IdRol") == 2)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cliente" asp-action="MisPedidos">
                            <i class="bi bi-clock-history me-1"></i>Mis Pedidos
                        </a>
                    </li>
                }
            </ul>

            <!-- Acciones derecha -->
            <div class="d-flex align-items-center gap-3">

                <!-- Carrito (solo no-admin) -->
                @if (Context.Session.GetInt32("Maido_IdRol") != 1)
                {
                    <a href="/Cart" class="btn btn-cart position-relative" id="btnCarritoNav">
                        <i class="bi bi-bag-fill"></i>
                        <span class="cart-badge" id="cartBadgeNav">0</span>
                    </a>
                }

                <!-- Auth -->
                @if (Context.Session.GetInt32("Maido_IdUsuario") != null)
                {
                    var nombre = Context.Session.GetString("Maido_Nombre") ?? "U";
                    var inicial = nombre.Substring(0, 1).ToUpper();
                    <div class="dropdown">
                        <button class="btn btn-user dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                            <span class="user-avatar">@inicial</span>
                            @nombre
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark maido-dropdown">
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Perfil">
                                    <i class="bi bi-person-vcard me-2"></i>Mi Perfil
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-accent">
                            <i class="bi bi-person me-1"></i>Ingresar
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-accent">
                            <i class="bi bi-person-plus me-1"></i>Registrarse
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>


<!-- ══════════════════════════════════════════════════════
     ALERTAS GLOBALES (TempData)
════════════════════════════════════════════════════════ -->
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 border-0" role="alert">
        <div class="container"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 border-0" role="alert">
        <div class="container"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══════════════════════════════════════════════════════
     CONTENIDO PRINCIPAL
════════════════════════════════════════════════════════ -->
<main class="page-transition">
    @RenderBody()
</main>

<!-- ══════════════════════════════════════════════════════
     FOOTER
════════════════════════════════════════════════════════ -->
<footer class="maido-footer mt-5 py-4">
    <div class="container text-center">
        <p class="mb-1 text-muted">
            <span class="brand-text-sm">MAIDO</span> &mdash; Cocina Nikkei &bull; Lima, Perú
        </p>
        <p class="text-muted small mb-0">
                &copy; @DateTime.Now.Year &bull; Maido &bull; Todos los derechos reservados.
        </p>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/carrito.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
