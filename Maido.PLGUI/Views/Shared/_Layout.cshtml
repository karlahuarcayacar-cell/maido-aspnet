<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Maido Restaurante</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Maido - Cocina Nikkei Peruano-Japonesa. Pedidos en línea, delivery y recojo en local.")">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts: Outfit & Noto Serif JP -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/maido.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAdminArea = controllerName.Equals("Admin", StringComparison.OrdinalIgnoreCase);
}

@if (!isAdminArea)
{
    <!-- ══════════════════════════════════════════════════════
         NAVBAR (Angular design)
    ════════════════════════════════════════════════════════ -->
    <nav class="navbar scrolled">
        <div class="container nav-inner">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="nav-logo">
                <span class="logo-jp display-font">間道</span>
                <span class="logo-text">MAIDO</span>
            </a>

            <!-- Links públicos -->
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li><a asp-controller="Home" asp-action="Menu">Menú</a></li>
            </ul>

            <!-- Acciones -->
            <div class="nav-actions">
                <!-- Carrito (solo no-admin) -->
                @if (Context.Session.GetInt32("Maido_IdRol") != 1)
                {
                    <a href="/Cart" class="cart-btn" title="Carrito" id="btnCarritoNav">
                        🛒
                        <span class="cart-badge" id="cartBadgeNav">0</span>
                    </a>
                }

                <!-- Usuario no logueado -->
                @if (Context.Session.GetInt32("Maido_IdUsuario") == null)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-ghost btn-sm">Iniciar sesión</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Registrarse</a>
                }
                else
                {
                    var nombre = Context.Session.GetString("Maido_Nombre") ?? "Usuario";
                    var inicial = nombre.Length > 0 ? nombre.Substring(0, 1).ToUpper() : "U";
                    <div class="user-menu" onclick="event.stopPropagation(); this.classList.toggle('open');">
                        <span class="user-avatar">@inicial</span>
                        <span class="user-name">@nombre</span>
                        <span class="chevron">▾</span>

                        <!-- Dropdown Glass -->
                        <div class="dropdown-glass">
                            <div class="dropdown-header">
                                <div class="dh-avatar">@inicial</div>
                                <div class="dh-info">
                                    <span class="dh-name">@nombre</span>
                                </div>
                            </div>
                            <hr class="divider" style="margin:0.5rem 0">
                            <a asp-controller="Cliente" asp-action="MisPedidos" class="dropdown-item">
                                <span class="di-icon">📋</span> Mis Pedidos
                            </a>
                            <a asp-controller="Account" asp-action="Perfil" class="dropdown-item">
                                <span class="di-icon">👤</span> Mi Perfil
                            </a>
                            @if (Context.Session.GetInt32("Maido_IdRol") == 1)
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="dropdown-item">
                                    <span class="di-icon">⚙️</span> Panel Admin
                                </a>
                            }
                            <hr class="divider" style="margin:0.5rem 0">
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item logout-btn">
                                    <span class="di-icon">🚪</span> Cerrar sesión
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </nav>
}

<!-- ══════════════════════════════════════════════════════
     CONTENIDO PRINCIPAL
════════════════════════════════════════════════════════ -->
<main>
    @RenderBody()
</main>

@if (!isAdminArea)
{
    <!-- ══════════════════════════════════════════════════════
         FOOTER (Angular design)
    ════════════════════════════════════════════════════════ -->
    <footer class="footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <span class="logo-jp display-font">間道</span>
                <span class="logo-text">MAIDO</span>
                <p class="footer-tagline">Alta cocina Nikkei &bull; Lima, Perú</p>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Home" asp-action="Menu">Menú</a>
                <a asp-controller="Account" asp-action="Login">Mi cuenta</a>
            </div>
            <p class="footer-copy">&copy; @DateTime.Now.Year Maido Restaurant. Todos los derechos reservados.</p>
        </div>
    </footer>
}

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/carrito.js" asp-append-version="true"></script>
<script>
    document.addEventListener('click', function (e) {
        var menu = document.querySelector('.user-menu');
        if (menu && !menu.contains(e.target)) {
            menu.classList.remove('open');
        }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

